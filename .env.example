# Local Docker defaults. Copy this file to .env and replace secrets.
DEBUG=True
LOCAL=False
SECRET_KEY=replace-with-a-long-random-value

# Host names only, without http:// or https://.
ALLOWED_HOSTS=127.0.0.1,localhost
# Public HTTPS base URL required by GREEN-API webhooks.
DOMAIN=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Docker Compose uses these values for the MySQL container and Django.
DB_NAME=omnichannel
DB_USER=omnichannel
DB_PASSWORD=replace-database-password
MYSQL_ROOT_PASSWORD=replace-local-root-password
DB_HOST=db
DB_PORT=3306

# Required for real-time events shared by web, connector and Celery.
REDIS_URL=redis://redis:6379/0

# Personal Telegram sessions are owned by the dedicated connector process.
RUN_TELETHON_CLIENTS=0

# Optional proxy when Docker/VPS cannot complete a direct Telegram MTProto handshake.
# Docker Desktop example: socks5://host.docker.internal:1080
TELEGRAM_PROXY_URL=

DJANGO_LOG_LEVEL=INFO

# Local HTTP settings. Enable secure values only after HTTPS is configured.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
